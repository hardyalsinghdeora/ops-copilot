# --- required for the agents (not for ingest / tests / retrieval eval) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- optional overrides (defaults shown) ---
# OPS_COPILOT_MODEL_STRONG=claude-sonnet-5-5
# OPS_COPILOT_MODEL_FAST=claude-haiku-5-5
# OPS_COPILOT_EMBEDDING_PROVIDER=local      # local | voyage | hashing
# VOYAGE_API_KEY=pa-...                     # only for embedding_provider=voyage
# OPS_COPILOT_CHUNK_SIZE=350
# OPS_COPILOT_CHUNK_OVERLAP=50
# OPS_COPILOT_RETRIEVAL_K=6
# OPS_COPILOT_MAX_REVIEW_ROUNDS=2
# OPS_COPILOT_MAX_TOOL_CALLS=8
# OPS_COPILOT_API_PORT=8000               # PORT works too (hosts like Render set it)
# OPS_COPILOT_API_TOKEN=                  # require "Authorization: Bearer <token>" on the API;
#                                         # set it whenever anyone else can reach the server
